# Production Environment Template (Do NOT commit actual passwords or keys)

# PostgreSQL Configuration
POSTGRES_USER=paratunisie
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=paratunisie
DATABASE_URL="postgresql://paratunisie:your_secure_postgres_password_here@paratunisie-postgres:5432/paratunisie?schema=public"

# Application URLs
FRONTEND_URL="http://paratunisie.com"
NEXT_PUBLIC_API_URL="http://paratunisie.com/api/v1"
PORT=3001

# Admin & Authentication Secrets
ADMIN_JWT_SECRET="your_generated_random_admin_jwt_secret_64_chars"
SEED_STAFF_PASSWORD="your_secure_admin_initial_password"

# Meilisearch
MEILI_HOST="http://paratunisie-meilisearch:7700"
MEILI_API_KEY="your_secure_meilisearch_master_key_here"

# MinIO Object Storage
MINIO_ROOT_USER="paratunisie_admin"
MINIO_ROOT_PASSWORD="your_secure_minio_root_password_here"
MINIO_PUBLIC_URL="http://paratunisie.com/media"

# Conversational AI (OpenRouter)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="dots-studio/dots-3-note-preview:free"

# SMS Gateway (WinSMS Pro)
SMS_PROVIDER=winsmspro
SMS_API_URL=https://www.winsmspro.com/sms/sms/api
SMS_API_KEY=your_winsms_api_key_here
SMS_SENDER_ID=SOBITAS
SMS_ENABLED=true

# SMTP Mail Gateway
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD="your_smtp_app_password"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME=ParaTunisie
MAIL_ENABLED=true
ADMIN_EMAIL=your_email@gmail.com
