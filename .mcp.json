{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${API_KEY_21ST}"
      }
    },
    "pollinations": {
      "command": "npx",
      "args": ["@pollinations/mcp"],
      "env": {
        "POLLINATIONS_API_KEY": "${POLLINATIONS_API_KEY}"
      }
    },
    "zsky": {
      "command": "python3",
      "args": ["C:\\Users\\Ala\\.claude\\external-mcp\\zsky-mcp-server.py"],
      "env": {
        "ZSKY_TOKEN": "${ZSKY_TOKEN}"
      }
    }
  }
}
